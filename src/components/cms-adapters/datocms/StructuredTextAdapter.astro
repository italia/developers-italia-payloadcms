---
import { getI18n } from "@i18n/microcopy";
import { lexicalToHtml } from "@utils/lexicalUtils";

type Props = {
  block: unknown;
};

const { block } = Astro.props;

const isLexical =
  block !== null &&
  typeof block === "object" &&
  !Array.isArray(block) &&
  (block as Record<string, unknown>)?.root;

const t = getI18n(Astro.locals.lang || "it");

const htmlContent = isLexical
  ? lexicalToHtml(block, {
      linkLabels: {
        internal: t["link.internal"],
        external: t["link.external"],
      },
      normalizeSpaces: true,
    })
  : null;
---

{htmlContent && <Fragment set:html={htmlContent} />}
