---
import { NewsFeed } from "@components/organisms/NewsFeed";
import type { ImageProps } from "@components/atoms/Image/types";
import type { SectionBackground } from "@utils/background";
import { DatoBlockModel } from "@utils/cmsMapper";
import { lexicalToHtml } from "@utils/lexicalUtils";
import { linkResolver } from "@utils/linkResolver";

// Data comes from a REST fetch (payloadFetch, per-locale) reshaped by
// normalizePayloadBlock (collections/loader.ts) — not a DatoCMS GraphQL fragment.
// tab.news items are flat, single-locale Payload docs: normalizePayloadBlock only
// auto-converts Lexical richText on the block's own direct keys, so each news item's
// own `paragraph` still needs lexicalToHtml() here.
type PayloadTopic = { label?: string | null } | null;

type PayloadNewsItem = {
  id: string;
  title: string | null;
  link: string | null;
  paragraph: unknown;
  dateOfPublication: string | null;
  image: ImageProps | null;
  topic: PayloadTopic;
};

type PayloadStoryItem = {
  id: string;
  title: string | null;
  paragraph: unknown;
  dateOfPublication: string | null;
  image: ImageProps | null;
  topic: PayloadTopic;
};

type PayloadWebinarItem = {
  id: string;
  title: string | null;
  paragraph: unknown;
  date: string | null;
  image: ImageProps | null;
  topic: PayloadTopic;
};

type PayloadInsightItem = {
  id: string;
  title: string | null;
  abstract: unknown;
  image: ImageProps | null;
  topic: PayloadTopic;
};

// Item of a mixed tab: a document of any of the listed collections. The id is
// prefixed with the collection ("story-items:…") by normalizePayloadBlock.
type PayloadMixedItem = {
  id: string;
  title: string | null;
  link?: string | null;
  paragraph?: unknown;
  abstract?: unknown;
  dateOfPublication?: string | null;
  date?: string | null;
  image?: ImageProps | null;
  topic?: PayloadTopic;
};

type Props = {
  block: {
    id: string;
    title: string;
    paragraph: string;
    backgroundColor: string;
    cta?: { id: string; label: string; linkTo?: { id: string } | null } | null;
    tabs: (
      | { componentName: "NewsTabRecord"; title: string; news: PayloadNewsItem[] }
      | { componentName: "StoryTabRecord"; title: string; Stories: PayloadStoryItem[] }
      | { componentName: "WebinarTabRecord"; title: string; Webinars: PayloadWebinarItem[] }
      | { componentName: "InsightTabRecord"; title: string; Insights: PayloadInsightItem[] }
      | { componentName: "MixedTabRecord"; title: string; items: PayloadMixedItem[] }
      | { componentName: string; title: string; news: unknown[] }
    )[];
  };
};

const { block } = Astro.props;
const { lang } = Astro.locals;

const buttonLink =
  block.cta?.linkTo?.id !== undefined
    ? linkResolver(block.cta.linkTo.id, lang)
    : undefined;
const buttonLabel = block.cta?.label;
---

<NewsFeed
  id={block.id}
  title={block.title}
  paragraph={block.paragraph}
  labelButton={buttonLabel}
  linkTo={buttonLink}
  backgroundColor={block.backgroundColor as SectionBackground}
  tabs={block.tabs.map((tab) => {
    switch (tab.componentName) {
      case DatoBlockModel.NewsTab:
        return {
          componentName: "CardEditorialNews",
          title: tab.title,
          news: (tab.news as PayloadNewsItem[]).map((n) => {
            const link = n.link ?? "";
            return {
              id: n.id,
              title: n.title ?? "",
              description: lexicalToHtml(n.paragraph) ?? "",
              image: n.image || undefined,
              linkTo: link || "#",
              category: n.topic?.label ?? "",
              dateTime: n.dateOfPublication ?? undefined,
            };
          }),
        };

      case DatoBlockModel.StoryTab:
        return {
          componentName: "CardEditorialStory",
          title: tab.title,
          news: ((tab as { Stories: PayloadStoryItem[] }).Stories ?? []).map((n) => {
            return {
              id: n.id,
              title: n.title ?? "",
              image: n.image || undefined,
              linkTo: linkResolver(`story-items:${n.id}`, lang),
              category: n.topic?.label ?? undefined,
              description: lexicalToHtml(n.paragraph) || undefined,
              dateTime: n.dateOfPublication || undefined,
            };
          }),
        };

      case DatoBlockModel.WebinarTab:
        return {
          componentName: "CardEditorialStory",
          title: tab.title,
          news: ((tab as { Webinars: PayloadWebinarItem[] }).Webinars ?? []).map((n) => {
            return {
              id: n.id,
              title: n.title ?? "",
              image: n.image || undefined,
              linkTo: linkResolver(`webinar-items:${n.id}`, lang),
              category: n.topic?.label ?? undefined,
              description: lexicalToHtml(n.paragraph) || undefined,
              dateTime: n.date || undefined,
            };
          }),
        };

      case DatoBlockModel.InsightTab:
        return {
          componentName: "CardEditorialStory",
          title: tab.title,
          news: ((tab as { Insights: PayloadInsightItem[] }).Insights ?? []).map((n) => {
            return {
              id: n.id,
              title: n.title ?? "",
              image: n.image || undefined,
              linkTo: linkResolver(`insights:${n.id}`, lang),
              category: n.topic?.label ?? undefined,
              description: lexicalToHtml(n.abstract) || undefined,
            };
          }),
        };

      case DatoBlockModel.MixedTab:
        return {
          componentName: "CardEditorialStory",
          title: tab.title,
          news: ((tab as { items: PayloadMixedItem[] }).items ?? []).map((n) => {
            // News items point to an external page, everything else to a site page.
            const externalLink = n.id.startsWith("news-items:") ? n.link : "";
            return {
              id: n.id,
              title: n.title ?? "",
              image: n.image || undefined,
              linkTo: externalLink || linkResolver(n.id, lang),
              category: n.topic?.label ?? undefined,
              description: lexicalToHtml(n.paragraph ?? n.abstract) || undefined,
              dateTime: n.dateOfPublication || n.date || undefined,
            };
          }),
        };

      default:
        return {
          componentName: "CardEditorialNews",
          title: tab.title,
          news: [],
        };
    }
  })}
/>
