---
import { Sidebar } from "@components/organisms/Sidebar";
import type {
  SidebarItemFirstLevelProps,
  SidebarItemSecondLevelProps,
} from "@components/organisms/Sidebar/types";
import type { SiteLocale } from "@graphql/types";
import { DatoBlockModel } from "@utils/cmsMapper";
import {
  createFlatMenuSidebar,
  createMenuSidebar,
  type MenuArticleItem,
  type SidebarMenu,
} from "@utils/createMenuSidebarHelper";
import { getLocaleValue } from "@utils/getLocaleValue";

// Matches the shape sidebarLoader (collections/loader.ts) builds from Payload's
// sidebar-for-article global — not a GraphQL fragment, this data comes over REST.
type SidebarData = {
  id: string;
  _allHeaderLabelLocales: { locale: SiteLocale; value: string }[];
  _allOpenLabelLocales: { locale: SiteLocale; value: string }[];
  _allCloseLabelLocales: { locale: SiteLocale; value: string }[];
  _allMenuLocales: { locale: SiteLocale; value: (MenuArticleItem | SidebarMenu)[] }[];
};

type Props = {
  sidebar: SidebarData;
};

const { sidebar } = Astro.props;
const currentPathname = Astro.url.pathname.replace(/\/$/, "");
const { lang } = Astro.locals;
const headerLabel = getLocaleValue(sidebar._allHeaderLabelLocales, lang, "");
const openLabel = getLocaleValue(sidebar._allOpenLabelLocales, lang, "");
const closeLabel = getLocaleValue(sidebar._allCloseLabelLocales, lang, "");

const menu = getLocaleValue(sidebar._allMenuLocales, lang, null);

if (!menu) {
  return;
}

const isMenuArticle = (item: any): item is MenuArticleItem =>
  item.componentName === DatoBlockModel.MenuArticleItem;

const isAccordionMenu = (item: any): item is SidebarMenu =>
  item.componentName === DatoBlockModel.AccordionMenu;

const menuItems = menu ?? [];

const flatItems = menuItems.filter(isMenuArticle) as MenuArticleItem[];
const accordionItems = menuItems.filter(isAccordionMenu) as SidebarMenu[];

const sidebarAccordionItems: SidebarItemFirstLevelProps[] = createMenuSidebar(
  accordionItems,
  currentPathname,
  lang,
);

const sidebarItems: SidebarItemSecondLevelProps[] = createFlatMenuSidebar(
  flatItems,
  currentPathname,
  lang,
);
---

<Sidebar
  id={sidebar.id}
  header={headerLabel || undefined}
  openLabel={openLabel}
  closeLabel={closeLabel}
  accordionItems={sidebarAccordionItems}
  flatItems={sidebarItems}
/>
