---
import Loader from "@components/Loader.astro";
import PreviewBar from "@components/PreviewBar.astro";
import type { LinkProps } from "@components/atoms/Link/types";
import FooterAdapter from "@components/cms-adapters/datocms/FooterAdapter.astro";
import HeaderAdapter from "@components/cms-adapters/datocms/HeaderAdapter.astro";
import { LastUpdate } from "@components/molecules/LastUpdate";
import Feedback from "@components/react/Feedback/Feedback";
import type { SeoFieldFragmentType } from "@graphql/fragment/seoFragments";
import { getGlobalSettings, getLayout } from "@lib/dataFetcher";
import { isDraftModeEnabled } from "@lib/draftMode";
import { type JsonLdPageData } from "@utils/JsonLD/seoJsonLd";
import { getEntry } from "astro:content";
import bsi from "bootstrap-italia/dist/js/bootstrap-italia.bundle.min.js?url";
import "../styles/global.scss";
import JsonLDScripts from "./JsonLDScripts.astro";
import SeoHreflang from "./SeoHreflang.astro";
import WAI from "./WAI.astro";

type Props = {
  seo?: SeoFieldFragmentType | null;
  redirectUrl?: string;
  datePublished?: string;
  jsonLd?: JsonLdPageData;
};

const isPreview = isDraftModeEnabled(Astro.cookies);
const { seo, redirectUrl, datePublished, jsonLd } = Astro.props;

const { lang } = Astro.locals;

const layoutEntry = await getLayout(isPreview);

// layout is always non-null: layoutLoader falls back to STATIC_LAYOUT_RECORD
const layout = layoutEntry?.data?.layout ?? {};
const { homepageId, search } = layoutEntry?.data || {};

const globalSetting = await getGlobalSettings(lang);

// ── SEO default (per-locale fallbacks) ──────────────────────────────────────
const seoDefaultEntry = await getEntry("seo_default", lang);
const seoDefault = seoDefaultEntry?.data;

const pageTitle = (seo?.title || seoDefault?.fallbackTitle || "")
  + (seoDefault?.titleSuffix || "");
const pageDescription = seo?.description || seoDefault?.fallbackDescription || "";
const ogImageUrl = (seo?.image as { url?: string } | null)?.url ?? seoDefault?.ogImage?.url ?? "";
const siteName = seoDefault?.siteName ?? "";
const faviconUrl = seoDefault?.favicon?.url ?? "";
// ─────────────────────────────────────────────────────────────────────────────

const headerLayout = {
  _allTaglineLocales: layout._allTaglineLocales ?? [],
  _allListNavbarBrandLocales: layout._allListNavbarBrandLocales ?? [],
  siteName: layout.siteName ?? "",
  allMainNavigation: layout.allMainNavigation ?? [],
  allSecondaryNavigation: layout.allSecondaryNavigation ?? [],
  allMetaNavigation: layout.allMetaNavigation ?? [],
  locales: layout.locales ?? ["it", "en"],
  logoSelect: layout.logoSelect ?? null,
  variant: layout.variant ?? "light",
};

const footerLayout = {
  _allHeadingLocales: layout._allHeadingLocales ?? [],
  _allOrganizationsLocales: layout._allOrganizationsLocales ?? [],
  _allTopicTitleLocales: layout._allTopicTitleLocales ?? [],
  _allTopicLinkLocales: layout._allTopicLinkLocales ?? [],
  _allUtilityTitleLocales: layout._allUtilityTitleLocales ?? [],
  _allUtilityLocales: layout._allUtilityLocales ?? [],
  _allSmallPrintLocales: layout._allSmallPrintLocales ?? [],
  _allMailingListFormLocales: layout._allMailingListFormLocales ?? [],
  showSitemapLink: layout.showSitemapLink ?? false,
};

const linksPrefooter: LinkProps[] =
  globalSetting?.links?.map((link: { url: string; label: string }) => ({
    url: link.url,
    label: link.label,
  })) || [];

const isShowingPreviewBar = isPreview && redirectUrl;
const isProd = import.meta.env.PROD;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href;
---

<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />

    <!-- Primary meta -->
    {pageTitle && <title>{pageTitle}</title>}
    {pageDescription && <meta name="description" content={pageDescription} />}
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    {pageTitle && <meta property="og:title" content={pageTitle} />}
    {pageDescription && <meta property="og:description" content={pageDescription} />}
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    {siteName && <meta property="og:site_name" content={siteName} />}
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    {pageTitle && <meta name="twitter:title" content={pageTitle} />}
    {pageDescription && <meta name="twitter:description" content={pageDescription} />}
    {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}

    <!-- Favicon -->
    {faviconUrl && <link rel="icon" href={faviconUrl} />}

    <!-- Font preloads -->
    <link rel="preload" href="/fonts/Titillium_Web/titillium-web-v10-latin-ext_latin-regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/Titillium_Web/titillium-web-v10-latin-ext_latin-600.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/Titillium_Web/titillium-web-v10-latin-ext_latin-700.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/Lora/lora-v20-latin-ext_latin-regular.woff2" as="font" type="font/woff2" crossorigin />

    <JsonLDScripts jsonLd={jsonLd} />
    {isProd && <WAI />}
    <SeoHreflang locales={headerLayout.locales} />
  </head>
  <body>
    {isShowingPreviewBar && <PreviewBar redirectUrl={redirectUrl} />}
    <HeaderAdapter
      {...headerLayout}
      homeRecordId={homepageId}
      search={search || undefined}
    />
    <main id="main">
      <slot />
      {
        datePublished && globalSetting && (
          <LastUpdate
            label={globalSetting.lastUpdateLabel}
            date={datePublished}
            links={linksPrefooter}
          />
        )
      }
      <Feedback client:visible lang={lang}>
        <div slot="fallback">
          <Loader />
        </div>
      </Feedback>
    </main>
    <FooterAdapter {...footerLayout} />
    <script src={bsi} defer is:inline></script>
  </body>
</html>
