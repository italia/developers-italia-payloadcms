---
import { lexicalToHtml } from "@utils/lexicalUtils";

type Props = {
  block: unknown;
};

const { block } = Astro.props;

const isLexical =
  block !== null &&
  typeof block === "object" &&
  !Array.isArray(block) &&
  (block as Record<string, unknown>)?.root;

const htmlContent = isLexical ? lexicalToHtml(block) : null;
---

{htmlContent && <Fragment set:html={htmlContent} />}
