{
  "name": "mywebsite",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "bun run generate-link-map && dotenv -- astro dev",
    "build": "bun run generate-link-map && dotenv -- astro build",
    "generate-link-map": "bun ./scripts/generate-link-map.ts",
    "generate-output": "gql.tada generate output",
    "tada-doctor": "gql-tada doctor",
    "tada-check": "gql-tada check",
    "prepare": "husky",
    "format": "prettier . --write --ignore-unknown",
    "index": "bun run ./scripts/index-opensearch.ts"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/react": "^4.4.2",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/ts-plugin": "^1.10.11",
    "@astrojs/vercel": "^9.0.5",
    "@datocms/astro": "^0.6.16",
    "@datocms/cda-client": "^0.2.10",
    "@datocms/cma-client": "^5.8.1",
    "@opensearch-project/opensearch": "^3.6.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^5.18.2",
    "bootstrap-italia": "^2.18.3",
    "dataviz-components": "^0.3.21",
    "datocms-structured-text-to-plain-text": "^5.1.16",
    "dotenv": "^16.6.1",
    "gql.tada": "^1.11.3",
    "graphql": "^16.14.2",
    "jsonwebtoken": "^9.0.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@datocms/cli": "^3.1.16",
    "@types/jsonwebtoken": "^9.0.10",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "astro-eslint-parser": "^1.4.0",
    "dotenv-cli": "^10.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier-plugin-astro": "^0.14.1",
    "sass-embedded": "^1.104.0",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "**/*.{js,ts,tsx,astro,scss}": [
      "eslint --fix",
      "prettier . --write --ignore-unknown"
    ]
  }
}
