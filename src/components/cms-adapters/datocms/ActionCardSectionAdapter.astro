---
import { ActionCardSection } from "@components/organisms/ActionCardSection";
import { VideoPlayer } from "@components/organisms/VideoPlayer";
import { createDownloadUrl } from "@utils/createDownloadUrl";
import { formatAssetInfo } from "@utils/formatAssetInfo";

type PayloadMediaDoc = {
  url: string;
  filename: string;
  mimeType: string;
  filesize: number;
};

type Props = {
  block: {
    id: string;
    title: string;
    paragraph: string;
    category: string | null;
    videoUrl: string | null;
    readMoreLabel: string;
    readLessLabel: string;
    cta?: { label: string; doc: PayloadMediaDoc } | null;
  };
};

const { block } = Astro.props;

// When the "Webinar transcript" block (action-card) has a videoUrl, show the
// VideoPlayer (transcript ← paragraph) instead of the download card.
const videoUrl = block.videoUrl ?? undefined;

const extension = block.cta?.doc.mimeType.split("/").pop() ?? "";
---

{
  videoUrl ? (
    <section class="it-section-bg-medium py-5">
      <div class="container">
        <VideoPlayer
          id={block.id}
          videoUrl={videoUrl}
          transcription={block.paragraph || undefined}
        />
      </div>
    </section>
  ) : (
    block.cta && (
      <ActionCardSection
        title={block.title}
        paragraph={block.paragraph}
        category={block.category || undefined}
        cta={{
          label: `${block.cta.label} ${formatAssetInfo(block.cta.doc.filesize, extension)}`,
          url: createDownloadUrl(block.cta.doc),
        }}
        labelButtonMore={block.readMoreLabel}
        labelButtonLess={block.readLessLabel}
      />
    )
  )
}
