---
import InternalLinkAdapter from "@components/cms-adapters/datocms/InternalLinkAdapter.astro";
import ExternalLinkAdapter from "@components/cms-adapters/datocms/ExternalLinkAdapter.astro";
import ListExternalLinkAdapter from "@components/cms-adapters/datocms/ListExternalLinkAdapter.astro";
import { getI18n } from "@i18n/microcopy";
import { lexicalToHtml } from "@utils/lexicalUtils";

type Props = {
  block: unknown;
};

type LexicalChild = {
  type: string;
  fields?: { blockType?: string; [key: string]: unknown };
};

// A run of consecutive text nodes, rendered to HTML, or a block embedded in the
// text (Lexical `block` node), rendered by its own adapter.
type Segment =
  | { kind: "html"; html: string }
  | { kind: "block"; blockType: string; fields: Record<string, unknown> };

const { block } = Astro.props;

const isLexical =
  block !== null &&
  typeof block === "object" &&
  !Array.isArray(block) &&
  (block as Record<string, unknown>)?.root;

const t = getI18n(Astro.locals.lang || "it");

const renderOptions = {
  linkLabels: {
    internal: t["link.internal"],
    external: t["link.external"],
  },
  normalizeSpaces: true,
};

const segments: Segment[] = [];

if (isLexical) {
  const root = (block as { root: { children?: LexicalChild[] } }).root;
  let run: LexicalChild[] = [];

  const flushRun = () => {
    if (run.length === 0) return;
    const html = lexicalToHtml(
      { root: { ...root, children: run } },
      renderOptions,
    );
    if (html) segments.push({ kind: "html", html });
    run = [];
  };

  for (const child of root.children ?? []) {
    if (child.type === "block" && child.fields?.blockType) {
      flushRun();
      segments.push({
        kind: "block",
        blockType: child.fields.blockType,
        fields: child.fields,
      });
    } else {
      run.push(child);
    }
  }
  flushRun();
}
---

{
  segments.map((segment) => {
    if (segment.kind === "html") {
      return <Fragment set:html={segment.html} />;
    }
    switch (segment.blockType) {
      case "list-external-link":
        return <ListExternalLinkAdapter block={segment.fields as never} />;
      case "external-link":
        return <ExternalLinkAdapter block={segment.fields as never} />;
      case "internal-link": {
        // `linkTo` is a polymorphic relationship: { relationTo, value } where
        // value is the document or its id. The link map is keyed "collection:id".
        const rel = segment.fields.linkTo as
          | { relationTo?: string; value?: string | { id?: string } | null }
          | undefined;
        const docId = typeof rel?.value === "object" ? rel?.value?.id : rel?.value;
        if (!rel?.relationTo || !docId) return null;
        return (
          <InternalLinkAdapter
            block={
              {
                label: segment.fields.label,
                linkTo: { id: `${rel.relationTo}:${docId}` },
              } as never
            }
          />
        );
      }
      default:
        return null;
    }
  })
}
